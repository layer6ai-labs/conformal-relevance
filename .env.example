# Conformal Relevancy - Environment Variables
# Copy this file to .env and fill in your API keys
#
# Only set the API key(s) for the provider(s) you plan to use.
# The default model is gemini-2.5-flash-lite which requires GOOGLE_API_KEY.

# OpenAI API Key (for gpt-* and o1-* models)
# Get your key at: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-...

# Google API Key (for gemini-* models)
# Get your key at: https://aistudio.google.com/apikey
# GOOGLE_API_KEY=...

# Anthropic API Key (for claude-* models)
# Get your key at: https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY=sk-ant-...

# Database configuration (for storing experiment results)
# Option 1: Full connection URL
# Format: postgresql://postgres:[PASSWORD]@db.[PROJECT_ID].supabase.co:5432/postgres
# Get your connection string from: https://supabase.com/dashboard/project/[PROJECT_ID]/settings/database
# SUPABASE_DATABASE_URL=postgresql://postgres:password@db.xxx.supabase.co:5432/postgres

# Option 2: Individual variables (password will be URL-encoded automatically)
# DB_USER=postgres
# DB_PASSWORD=your-password-here
# DB_HOST=db.xxx.supabase.co
# DB_PORT=5432
# DB_DBNAME=postgres

# Ollama (local LLM server — no API key required)
OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_NUM_CTX=8192        # Optional: context window size (uncomment for long-doc datasets)
# OLLAMA_TIMEOUT=300         # Optional: request timeout in seconds
